        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="label">
    <xs:annotation>
      <xs:documentation>(label) contains any label or heading used to identify part of a text, typically but not exclusively in a list or glossary. [3.8.
              Lists]</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:complexContent>
